# LLM provider config
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Optional model aliases (cheap/strong) for two-stage cost optimization
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_STRONG_MODEL=gpt-4o

# Vision-capable model for Phase 12 computer-use fallback
# Example free Kilo/OpenRouter model: stepfun/step-3.7-flash:free
LLM_VISION_MODEL=
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=

# Qdrant vector store
# Use QDRANT_URL for a local Qdrant instance or QDRANT_ENDPOINT for Qdrant Cloud.
QDRANT_ENDPOINT=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Observability
ATLAS_ENABLE_OTEL=false
ATLAS_OTEL_CAPTURE_CONTENT=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Search / MCP
TAVILY_API_KEY=

# MCP server configuration
# Exa MCP remote works without an API key and without Node.js.
MCP_EXA_URL=https://mcp.exa.ai/mcp
# Optional stdio MCP servers (require npx/Node.js). Set to 1 to enable.
MCP_ARXIV_ENABLED=0
MCP_GITHUB_ENABLED=0
MCP_NEWS_ENABLED=0
GITHUB_TOKEN=
# You can also provide a JSON list of servers via MCP_SERVERS.
# Example: MCP_SERVERS='[{"server_id":"exa","transport":"streamable-http","url":"https://mcp.exa.ai/mcp"}]'
MCP_SERVERS=
MCP_CONNECT_TIMEOUT=30

# Embedding provider (Gemini free tier is recommended for RAG)
GEMINI_API_KEY=AIza...
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Fallback embedding / vector store
# Set QDRANT_PATH to a directory for persistent vector storage.
QDRANT_PATH=data/qdrant

# App
ATLAS_ENABLE_APPROVAL=false
ATLAS_PERSIST_DIR=data/research

# Computer-use / Playwright settings
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium
