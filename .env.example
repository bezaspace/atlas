# LLM provider config
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Optional model aliases (cheap/strong) for two-stage cost optimization
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_STRONG_MODEL=gpt-4o

# Qdrant vector store
# Use QDRANT_URL for a local Qdrant instance or QDRANT_ENDPOINT for Qdrant Cloud.
QDRANT_ENDPOINT=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Observability
ATLAS_ENABLE_OTEL=false
ATLAS_OTEL_CAPTURE_CONTENT=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Search / MCP
EXA_MCP_URL=https://mcp.exa.ai/mcp
TAVILY_API_KEY=

# App
ATLAS_ENABLE_APPROVAL=false
